[Desktop Entry]
# The version of the desktop entry spec this conforms to.
Version=1.0

Type=Application

Name=BrasaPreview
GenericName=TerminalEmulator

Exec=brasa-terminal-preview %U
StartupWMClass=dev.brasa.BrasaPreview

Keywords=shell;prompt;command;commandline;cmd;

Icon=dev.brasa.BrasaPreview

Categories=System;TerminalEmulator;

# Don't run this application within a terminal.
Terminal=false

# Register ourselves as the handler for brasapreview:// URLs.
MimeType=x-scheme-handler/brasapreview;
