[Desktop Entry]
# The version of the desktop entry spec this conforms to.
Version=1.0

Type=Application

Name=Brasa
GenericName=TerminalEmulator

Exec=brasa-terminal %U
StartupWMClass=dev.brasa.Brasa

Keywords=shell;prompt;command;commandline;cmd;

Icon=dev.brasa.Brasa

Categories=System;TerminalEmulator;

# Don't run this application within a terminal.
Terminal=false

# Register ourselves as the handler for brasa:// URLs.
MimeType=x-scheme-handler/brasa;
